{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "workspace": {
      "minLength": 1,
      "type": "string"
    },
    "trigger": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "type": {
              "const": "manual",
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "type": {
              "const": "event",
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "type": {
              "const": "interval",
              "type": "string"
            },
            "seconds": {
              "minimum": 60,
              "maximum": 604800,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "seconds"
          ]
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "type": {
              "const": "cron",
              "type": "string"
            },
            "expression": {
              "minLength": 1,
              "type": "string"
            },
            "timezone": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "expression",
            "timezone"
          ]
        }
      ]
    },
    "schedule_paused": {
      "type": "boolean"
    },
    "timeout_seconds": {
      "minimum": 10,
      "maximum": 2700,
      "type": "integer"
    },
    "sandbox": {
      "anyOf": [
        {
          "const": "read-only",
          "type": "string"
        },
        {
          "const": "workspace-write",
          "type": "string"
        }
      ]
    },
    "session": {
      "anyOf": [
        {
          "const": "new",
          "type": "string"
        },
        {
          "const": "resume",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "version",
    "id",
    "workspace",
    "trigger",
    "schedule_paused",
    "timeout_seconds",
    "sandbox",
    "session"
  ]
}
