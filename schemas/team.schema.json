{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "steps": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "agent",
                "type": "string"
              },
              {
                "const": "decision",
                "type": "string"
              }
            ]
          },
          "needs": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "type": "string"
            }
          },
          "role": {
            "pattern": "^(engineering|operations|sales|executive)/[a-z][a-z0-9-/]*$",
            "type": "string"
          },
          "placement": {
            "anyOf": [
              {
                "const": "control",
                "type": "string"
              },
              {
                "const": "isolated",
                "type": "string"
              },
              {
                "const": "candidate",
                "type": "string"
              }
            ]
          },
          "contract": {
            "anyOf": [
              {
                "const": "plan",
                "type": "string"
              },
              {
                "const": "candidate",
                "type": "string"
              },
              {
                "const": "review",
                "type": "string"
              },
              {
                "const": "qa",
                "type": "string"
              },
              {
                "const": "delivery",
                "type": "string"
              },
              {
                "const": "verification",
                "type": "string"
              },
              {
                "const": "generic",
                "type": "string"
              }
            ]
          },
          "gate": {
            "anyOf": [
              {
                "const": "plan",
                "type": "string"
              },
              {
                "const": "release",
                "type": "string"
              },
              {
                "const": "publication",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "needs"
        ]
      }
    }
  },
  "required": [
    "version",
    "id",
    "description",
    "steps"
  ]
}
